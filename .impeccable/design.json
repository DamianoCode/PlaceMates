      "css": ".ds-input{width:280px;height:44px;padding:8px 14px;border:1px solid var(--color-input,oklch(0.9 0.02 70));border-radius:var(--radius-lg,0.75rem);background:transparent;color:var(--color-foreground,oklch(0.22 0.02 50));font:400 16px/1.4 Outfit,system-ui,sans-serif;outline:none;transition:border-color 120ms ease,box-shadow 120ms ease}.ds-input::placeholder{color:var(--color-muted-foreground,oklch(0.5 0.02 50))}.ds-input:focus-visible{border-color:oklch(0.58 0.14 42 / 0.5);box-shadow:0 0 0 3px oklch(0.58 0.14 42 / 0.25)}"
