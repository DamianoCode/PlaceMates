      "html": "<button class=\"ds-btn-primary\">Zapisz ocenę</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:44px;padding:0 16px;border:1px solid transparent;border-radius:var(--radius-lg,0.75rem);background:var(--color-primary,oklch(0.58 0.14 42));color:var(--color-primary-foreground,oklch(0.98 0.012 80));font:500 14px/1 Outfit,system-ui,sans-serif;cursor:pointer;transition:all 150ms ease-out;outline:none}.ds-btn-primary:hover{background:oklch(0.58 0.14 42 / 0.8)}.ds-btn-primary:focus-visible{box-shadow:0 0 0 3px oklch(0.58 0.14 42 / 0.5)}.ds-btn-primary:active{transform:translateY(1px)}"
    },
