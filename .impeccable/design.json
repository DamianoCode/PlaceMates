    {
      "name": "Filter Chip Bar",
      "kind": "chip",
      "refersTo": "chip-filter",
      "description": "Pill bar floating over the map with active and inactive chips.",
      "html": "<div class=\"ds-chipbar\"><button class=\"ds-chip ds-chip--on\" aria-pressed=\"true\">Wszystkie</button><button class=\"ds-chip\" aria-pressed=\"false\">Kawiarnie</button><button class=\"ds-chip\" aria-pressed=\"false\">Widoki</button></div>",
      "css": ".ds-chipbar{display:inline-flex;gap:6px;padding:4px;border:1px solid oklch(0.88 0.02 70 / 0.5);border-radius:9999px;background:oklch(0.98 0.012 80 / 0.95);box-shadow:0 4px 6px -1px rgb(0 0 0 / 0.1),0 2px 4px -2px rgb(0 0 0 / 0.1)}.ds-chip{height:36px;padding:0 14px;border:0;border-radius:9999px;background:transparent;color:var(--color-muted-foreground,oklch(0.5 0.02 50));font:500 12px/1 Outfit,system-ui,sans-serif;cursor:pointer;transition:background-color 200ms ease-out,color 200ms ease-out,transform 200ms ease-out}.ds-chip:hover{background:var(--color-muted,oklch(0.95 0.015 75));color:var(--color-foreground,oklch(0.22 0.02 50))}.ds-chip:focus-visible{outline:none;box-shadow:0 0 0 3px oklch(0.58 0.14 42 / 0.5)}.ds-chip:active{transform:scale(0.97)}.ds-chip--on,.ds-chip--on:hover{background:var(--color-primary,oklch(0.58 0.14 42));color:var(--color-primary-foreground,oklch(0.98 0.012 80));box-shadow:0 1px 3px 0 oklch(0.58 0.14 42 / 0.3)}"
    },
    {
      "name": "Place Card",
      "kind": "card",
      "refersTo": "card-place",
      "description": "Flat list card; Fraunces place name, stars, apricot press wash.",
      "html": "<a class=\"ds-place\" href=\"#\"><div class=\"ds-place__thumb\"></div><div><h3 class=\"ds-place__name\">Kawiarnia Pod Lipą</h3><p class=\"ds-place__meta\">Kawiarnia · Kraków</p><span class=\"ds-place__score\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"oklch(0.828 0.189 84.429)\" stroke=\"oklch(0.769 0.188 70.08)\" stroke-width=\"2\" stroke-linejoin=\"round\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z\"/></svg><b>4.35</b><small>· 3 oceny</small></span></div></a>",
      "css": ".ds-place{display:flex;gap:12px;width:320px;padding:12px;border:1px solid var(--color-border,oklch(0.88 0.02 70));border-radius:var(--radius-2xl,1.35rem);background:var(--color-card,#fff);color:var(--color-foreground,oklch(0.22 0.02 50));text-decoration:none;transition:all 150ms ease-out}.ds-place:hover{background:oklch(0.92 0.04 70 / 0.4)}.ds-place:active{transform:scale(0.985);background:oklch(0.92 0.04 70 / 0.5)}.ds-place:focus-visible{outline:none;box-shadow:0 0 0 2px oklch(0.98 0.012 80),0 0 0 4px oklch(0.58 0.14 42 / 0.5)}.ds-place__thumb{width:72px;height:72px;flex:none;border-radius:var(--radius-xl,1.05rem);background:oklch(0.94 0.02 75)}.ds-place__name{margin:0;font:400 18px/1.25 Fraunces,Georgia,serif;letter-spacing:-0.015em}.ds-place__meta{margin:2px 0 0;font:italic 400 12px/1.4 Outfit,system-ui,sans-serif;color:oklch(0.5 0.02 50)}.ds-place__score{display:inline-flex;align-items:center;gap:4px;margin-top:8px;font:400 14px/1 Outfit,system-ui,sans-serif}.ds-place__score b{font-weight:500;font-variant-numeric:tabular-nums}.ds-place__score small{font-size:12px;color:oklch(0.5 0.02 50)}"
    },
