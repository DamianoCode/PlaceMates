# --- Public (browser-safe) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New naming ("publishable key"). Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key
# Canonical URL for share links, OAuth redirects, email templates.
# Set to https://<your-domain> in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only -----------------------------------------------------
# Direct Postgres connection. Supabase: Settings -> Database -> Connection string
# Use the "Transaction pooler" string for serverless (Vercel). Port 6543.
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Service-role key — server only, NEVER expose to client. Needed only for admin ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nominatim (OSM) proxy — required by their usage policy.
NOMINATIM_USER_AGENT=PlaceMates (contact: you@example.com)

# Geoapify Geocoding API key — OPTIONAL. When set, becomes the primary
# POI search provider (better small-town ranking, native proximity bias,
# 3000 req/day free tier). Sign up at https://myprojects.geoapify.com/.
# Leave blank to fall back to keyless Photon + Nominatim.
GEOAPIFY_API_KEY=

# =====================================================================
# Production hardening checklist (do this in Supabase dashboard, not here)
# =====================================================================
#
# 1. AUTH → EMAIL → "Confirm email"  →  ENABLE
#    Bots struggle with email round-trips; legit users just click a link.
#
# 2. AUTH → RATE LIMITS
#    Default limits (60 signups/hour/IP, 30 sign-ins/hour/IP) are sane.
#    Tighten if you see abuse. These are per-IP, stored in Supabase.
#
# 3. AUTH → PROVIDERS → GOOGLE  →  ENABLE
#    a) In Google Cloud Console, create OAuth 2.0 Client (Web):
#       https://console.cloud.google.com/apis/credentials
#    b) Authorised JavaScript origin:
#       https://<your-domain>
#    c) Authorised redirect URI — USE THE ONE SUPABASE SHOWS YOU:
#       https://<project-ref>.supabase.co/auth/v1/callback
#    d) Paste Client ID + Client Secret into Supabase.
#
# 4. AUTH → URL CONFIGURATION
#    Site URL:           https://<your-domain>
#    Redirect URLs:      https://<your-domain>/auth/callback
#                        https://<your-domain>/**     (covers dev/preview)
#    (Supabase refuses to redirect anywhere not whitelisted — prevents
#     open-redirect abuse on the OAuth callback.)
#
# 5. DATABASE → EXTENSIONS  →  postgis  →  ENABLE  (one-off)
#
# 6. STORAGE  →  run scripts/setup-storage.sql once in the SQL Editor
#    Creates the place-photos + avatars buckets with scoped policies.
#
# 7. Run migrations once on the production DB:
#       npm run db:migrate
#       npm run db:seed
#
# 8. Vercel → Project → Environment Variables — copy every NEXT_PUBLIC_*
#    and server-only var above. Remember to redeploy after changing env.
