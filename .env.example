# --- Public (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only ---
# Direct Postgres connection (Supabase: Settings -> Database -> Connection string -> URI)
# Use the "Transaction pooler" string for serverless (Vercel).
DATABASE_URL=postgres://postgres:password@host:6543/postgres?sslmode=require

# Service-role key — server only, NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nominatim (OSM) proxy — required by their usage policy.
NOMINATIM_USER_AGENT=ratings-app (contact: you@example.com)
